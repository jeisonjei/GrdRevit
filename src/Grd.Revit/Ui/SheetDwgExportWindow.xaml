<Window x:Class="GrdRevit.Ui.SheetDwgExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Экспорт в DWG"
        Width="760" Height="760"
        MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GrdRevit;component/Ui/Themes/Modern.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="10">
        <GroupBox DockPanel.Dock="Top" Margin="0,0,0,6" Padding="6">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Что экспортировать:" VerticalAlignment="Center" Margin="2,0,10,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <RadioButton x:Name="RbSheets" Content="Листы" GroupName="DwgSource" IsChecked="True"
                                 VerticalAlignment="Center" Checked="OnSourceChanged"/>
                    <RadioButton x:Name="RbViews" Content="Виды" GroupName="DwgSource" Margin="14,0,0,0"
                                 VerticalAlignment="Center" Checked="OnSourceChanged"
                                 ToolTip="Экспорт видов (планы, разрезы, фасады, 3D, узлы) в один DWG-файл."/>
                    <TextBlock x:Name="SourceStatus" VerticalAlignment="Center" Margin="18,0,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
                <TextBlock x:Name="HintText" TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="Отметьте листы и нажмите «Экспорт в DWG» — выбранные листы сохраняются в один DWG-файл, где каждый лист становится отдельным layout. Последний путь сохранения запоминается. Звёздочка ★ отмечает избранные листы — они общие с окном «Печать в PDF» и запоминаются по документу."
                           Margin="2,4,2,0"/>
            </StackPanel>
        </GroupBox>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ExportBtn" Content="Экспорт в DWG" Click="OnExport" Padding="16,6"
                        Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False"
                        ToolTip="Сохранить отмеченные элементы (листы или виды) в DWG: листы — в один файл (каждый лист — layout), виды — отдельным файлом на каждый вид."/>
                <TextBlock x:Name="PercentText" Margin="12,0,0,0" VerticalAlignment="Center"
                           MinWidth="46" TextAlignment="Right" FontWeight="SemiBold"/>
            </StackPanel>
            <StackPanel x:Name="PrefixPanel" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                <TextBlock Text="Префикс имени файла:" VerticalAlignment="Center" Margin="2,0,6,0"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBox x:Name="PrefixBox" Width="220" Padding="4,3"
                         Text="Виды_"
                         ToolTip="Префикс добавляется к имени каждого файла DWG: «префикс + имя вида». Пример: префикс «ВЦ_» и вид «План этажа 1» → «ВЦ_План этажа 1.dwg». Поле пустое — файл называется просто именем вида."/>
                <TextBlock Text="виды сохраняются в один файл DWG каждый" Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
            <ProgressBar x:Name="Progress" Height="18" Margin="0,6,0,0" Minimum="0" Maximum="1" Value="0"/>
            <TextBlock x:Name="StatusText" Margin="2,4,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>

        <GroupBox x:Name="ListGroupBox" Header="Листы" Padding="4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="2,0,6,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox x:Name="SearchBox" Width="240" Padding="4,3" TextChanged="OnSearchChanged"/>
                        <Button Content="Сбросить" Click="OnSearchReset" Margin="6,0,0,0" Padding="8,2"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="2,5,0,0">
                        <Button x:Name="SelectAllBtn" Content="Выбрать все" Click="OnSelectAll" Padding="8,2"/>
                        <Button x:Name="SelectNoneBtn" Content="Снять все" Click="OnSelectNone" Margin="6,0,0,0" Padding="8,2"/>
                        <Button x:Name="SelectFavBtn" Content="★ Отметить избранное" Click="OnSelectFav" Margin="6,0,0,0" Padding="8,2"
                                ToolTip="Отметить для экспорта все избранные (★) элементы списка и снять отметки с остальных."/>
                        <CheckBox x:Name="OnlyCheckedCheck" Content="Только выбранные" Margin="14,0,0,0"
                                  VerticalAlignment="Center" Checked="OnOnlyCheckedChanged" Unchecked="OnOnlyCheckedChanged"
                                  ToolTip="Показывать в списке только отмеченные элементы."/>
                        <CheckBox x:Name="OnlyFavCheck" Content="★ Только избранное" Margin="14,0,0,0"
                                  VerticalAlignment="Center" Checked="OnOnlyFavChanged" Unchecked="OnOnlyFavChanged"
                                  ToolTip="Показывать в списке только избранные (★) элементы. Избранное запоминается по документу: для листов — общее с «Печатью в PDF», для видов — с окном «Управляющий видами»."/>
                        <TextBlock x:Name="SheetCount" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="SelectedCount" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
                <ListBox x:Name="SheetsList" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewKeyDown="OnListPreviewKeyDown"
                         ToolTip="Пробел — отметить/снять элемент (лист или вид), на котором стоит выделение.">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Click="OnFavClick" Tag="{Binding}" Padding="0" Margin="0,0,4,0"
                                        Background="Transparent" BorderThickness="0" FontSize="14"
                                        VerticalAlignment="Center" HorizontalAlignment="Left"
                                        ToolTip="Отметить элемент как избранный (★). Для листов избранное общее с «Печатью в PDF», для видов — с окном «Управляющий видами»;">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="☆"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                        <Setter Property="Text" Value="★"/>
                                                        <Setter Property="Foreground" Value="DarkGoldenrod"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                                <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0"
                                          IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                          Click="OnSheetCheckToggled"/>
                                <TextBlock Grid.Column="2" Text="{Binding Display}" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </GroupBox>
    </DockPanel>
</Window>