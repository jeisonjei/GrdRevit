<Window x:Class="GrdRevit.Ui.ScheduleSnapshotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Снимок спецификаций"
        Width="1280" Height="760"
        MinWidth="980" MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GrdRevit;component/Ui/Themes/Modern.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="10">
        <GroupBox DockPanel.Dock="Top" Margin="0,0,0,6" Padding="6">
            <TextBlock Text="Спецификации, размещённые на листах. Таблица справа — редактируемый снимок: правки хранятся только в этом окне и не попадают в модель. Кнопка «Обновить из модели» возвращает спецификацию к исходному виду (марки, наименования, количество)."
                       TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
        </GroupBox>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Слева: листы со спецификациями ===== -->
            <GroupBox Grid.Column="0" Header="Листы со спецификациями" Padding="4" Margin="0,0,6,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="2,0,6,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox x:Name="SearchBox" Width="220" Padding="4,3" TextChanged="OnSearchChanged"/>
                            <Button Content="Сбросить" Click="OnSearchReset" Margin="6,0,0,0" Padding="8,2"/>
                        </StackPanel>
                        <TextBlock x:Name="SheetCount" Margin="2,3,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Button x:Name="MultiPrintBtn" Content="Печатать выбранные в PDF (ГОСТ)"
                                Click="OnPrintSelected" Margin="2,5,0,0" Padding="8,3"
                                HorizontalAlignment="Left" IsEnabled="False"
                                ToolTip="Каждый отмеченный лист — с рамкой и штампом ГОСТ и его отредактированной спецификацией. Все листы сохраняются в один PDF-файл."/>
                        <Button x:Name="ExportExcelBtn" Content="Экспорт выбранных в Excel (один файл)"
                                Click="OnExportExcel" Margin="2,4,0,0" Padding="8,3"
                                HorizontalAlignment="Left" IsEnabled="False"
                                ToolTip="Каждая отмеченная спецификация — отдельный лист книги в одном файле .xlsx (заголовки и строки с учётом правок, замороженная шапка, автофильтр)."/>
                        <Button x:Name="CreateFreeBtn" Content="Новая свободная спецификация…"
                                Click="OnCreateFree" Margin="2,4,0,0" Padding="8,3"
                                HorizontalAlignment="Left"
                                ToolTip="Создать пустую спецификацию на новом листе: заголовки колонок берутся у выбранного образца, строки вводятся вручную и хранятся только в плагине."/>
                        <StackPanel Orientation="Horizontal" Margin="2,3,0,0">
                            <CheckBox x:Name="FavOnlyCheck" Content="★ Только избранное"
                                      VerticalAlignment="Center"
                                      Checked="OnFavOnlyChanged" Unchecked="OnFavOnlyChanged"
                                      ToolTip="Показывать только листы со спецификациями, отмеченные звёздочкой ★"/>
                            <TextBlock x:Name="SelectedCount" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <ListBox x:Name="SheetsList" SelectionChanged="OnSheetSelected"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              Click="OnSheetCheckToggled"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Display}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Click="OnFavoriteClick" Tag="{Binding}"
                                            Padding="0" Margin="4,0" Background="Transparent"
                                            BorderThickness="0" FontSize="13" VerticalAlignment="Center"
                                            ToolTip="Отметить как избранное (★)">
                                        <TextBlock HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="☆"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                            <Setter Property="Text" Value="★"/>
                                                            <Setter Property="Foreground" Value="DarkGoldenrod"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </GroupBox>

            <!-- ===== Справа: редактируемая таблица ===== -->
            <GroupBox Grid.Column="1" Header="Спецификация (редактируемый снимок)" Padding="4" Margin="6,0,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ScheduleLabel" VerticalAlignment="Center" FontWeight="SemiBold"
                                       FontSize="14"/>
                            <Button x:Name="RefreshBtn" Content="Обновить из модели" Click="OnRefresh" Margin="16,0,0,0"
                                    Padding="12,5"
                                    ToolTip="Перечитать спецификацию из модели и заменить таблицу (правки будут потеряны)."/>
                            <Button x:Name="PrintBtn" Content="Печать в PDF" Click="OnPrint" Margin="8,0,0,0"
                                    Padding="12,5" Style="{StaticResource PrimaryButtonStyle}"
                                    ToolTip="Сохранить текущую таблицу (с правками) в PDF-файл."/>
                            <Button x:Name="SheetPrintBtn" Content="Печать листа (ГОСТ)" Click="OnPrintSheet" Margin="8,0,0,0"
                                    Padding="12,5"
                                    ToolTip="Пустой лист (рамка и штамп, форма ГОСТ) плюс текущая отредактированная таблица в месте спецификации."/>
                            <CheckBox Content="Переносить строки ячеек" Margin="16,0,0,0"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding WrapCells, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      ToolTip="Длинные значения переносятся на несколько строк, высота строк растёт автоматически."/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <Button x:Name="UndoBtn" Content="Отменить" Click="OnUndo" Padding="10,3"
                                    IsEnabled="False" ToolTip="Отменить последнее действие (Ctrl+Z)."/>
                            <Button x:Name="RedoBtn" Content="Вернуть" Click="OnRedo" Margin="6,0,0,0" Padding="10,3"
                                    IsEnabled="False" ToolTip="Вернуть отменённое действие (Ctrl+Y)."/>
                            <Button x:Name="ResetBtn" Content="Сбросить правки" Click="OnReset" Margin="6,0,0,0" Padding="10,3"
                                    IsEnabled="False" ToolTip="Вернуть таблицу к данным модели и удалить сохранённые правки этой спецификации."/>
                            <Button x:Name="AddRowBtn" Content="Добавить строку" Click="OnAddRow" Margin="6,0,0,0" Padding="10,3"
                                    IsEnabled="False" ToolTip="Вставить пустую строку под выделенной (иначе в конец). Горячая клавиша — Insert."/>
                            <Button x:Name="DelRowBtn" Content="Удалить строку" Click="OnDeleteRow" Margin="6,0,0,0" Padding="10,3"
                                    IsEnabled="False" ToolTip="Удалить выделенные строки. Горячая клавиша — Ctrl+Delete."/>
                            <Button x:Name="ExportBtn" Content="Экспорт в CSV" Click="OnExportCsv" Margin="6,0,0,0" Padding="10,3"
                                    ToolTip="Сохранить текущую таблицу (с правками) в CSV для Excel."/>
                        </StackPanel>
                        <TextBlock x:Name="PrintStatus" Margin="2,3,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <Grid>
                        <DataGrid x:Name="GridTable" AutoGenerateColumns="False" IsReadOnly="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                                  GridLinesVisibility="All" CellEditEnding="OnCellEditEnding"
                                  PreparingCellForEdit="GridTable_PreparingCellForEdit"
                                  HeadersVisibility="Column" ClipboardCopyMode="None"
                                  PreviewKeyDown="OnGridKeyDown"
                                  SelectionMode="Extended" SelectionUnit="Cell">
                            <DataGrid.RowHeight>1</DataGrid.RowHeight>
                        </DataGrid>
                        <TextBlock x:Name="EmptyHint" Text="Выберите спецификацию слева."
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="14"/>
                    </Grid>
                </DockPanel>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>