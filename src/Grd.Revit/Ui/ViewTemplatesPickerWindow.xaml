<Window x:Class="GrdRevit.Ui.ViewTemplatesPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Шаблон вида"
        Width="540" Height="560"
        MinWidth="420" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GrdRevit;component/Ui/Themes/Modern.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="12">
        <Border DockPanel.Dock="Bottom" Padding="0,10,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OkButton" Content="Выбрать" Style="{StaticResource PrimaryButtonStyle}" Click="OnOk"
                        Padding="18,6" FontWeight="SemiBold" IsDefault="True"/>
                <Button Content="Отмена" Click="OnCancel" Margin="8,0,0,0" Padding="18,6" IsCancel="True"/>
            </StackPanel>
        </Border>

        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock x:Name="HintText" Margin="1,0,0,6" TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="Шаблон будет применяться к видам через кнопки «Применить ШВ» (разово) и «Связать ШВ» (синхронизация с шаблоном)."/>
                <TextBox x:Name="SearchBox" Padding="6,4" TextChanged="OnSearchChanged"/>
            </StackPanel>

            <ListBox x:Name="TemplatesList"
                     SelectionMode="Single"
                     Background="{StaticResource CardBgBrush}"
                     BorderBrush="{StaticResource BorderBrush}"
                     BorderThickness="1"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="OnListDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13"
                                       Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding KindText}" FontSize="12" Margin="12,0,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </DockPanel>
</Window>