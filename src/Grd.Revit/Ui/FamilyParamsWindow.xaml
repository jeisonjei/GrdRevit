<Window x:Class="GrdRevit.Ui.FamilyParamsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Параметры семейств"
        Width="1020" Height="700"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GrdRevit;component/Ui/Themes/Modern.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="10">
        <GroupBox DockPanel.Dock="Top" Header="Параметры для применения (к выбранным семействам)" Margin="0,0,0,8" Padding="4">
            <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,4">
                    <Button Content="Добавить обычный параметр" Click="OnAddFamilyParam" Padding="8,3"/>
                    <Button Content="Добавить общий параметр…" Click="OnAddSharedParam" Margin="6,0,0,0" Padding="8,3"/>
                    <Button Content="Удалить выбранные строки" Click="OnRemoveOps" Margin="6,0,0,0" Padding="8,3"/>
                    <TextBlock VerticalAlignment="Center" Margin="12,0,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="«Общий» = общий (shared) параметр из файла; «Семейный» = обычный параметр семейства. «Изменить привязку» = переключить экземпляр↔тип."/>
                </StackPanel>
                <DataGrid x:Name="OpsGrid"
                          ItemsSource="{Binding Ops}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="True" CanUserDeleteRows="True"
                          HeadersVisibility="Column"
                          MinHeight="120" MaxHeight="260"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextTrimming="None" TextWrapping="NoWrap"
                                                   TextAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="4,0"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Общий" Width="64" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsShared}" IsHitTestVisible="False" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsShared, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Margin="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Операция" Width="96">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="4,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.StatusOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding Status, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Имя параметра" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="3*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="6,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Тип значения" Width="116">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StorageType}" VerticalAlignment="Center" Margin="4,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.StorageOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding StorageType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Группа" Binding="{Binding Group, UpdateSourceTrigger=PropertyChanged}" Width="1*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="6,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Экземпляр" Width="92" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsInstance}" IsHitTestVisible="False" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsInstance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Margin="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </GroupBox>

        <GroupBox DockPanel.Dock="Bottom" Header="Применение" Margin="0,0,0,0" Padding="6">
            <StackPanel>
                <TextBlock Text="Выберите семейства (слева) и задайте параметры выше, затем нажмите «Применить». Каждое семейство редактируется и загружается обратно в документ."
                           TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,2,6"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,2,0,0">
                    <Button Content="Применить к выбранным семействам" Click="OnApply"
                            Style="{StaticResource PrimaryButtonStyle}" Padding="12,5"/>
                    <Button Content="Загрузить файл общих параметров..." Click="OnLoadSharedFile" Margin="8,0,0,0" Padding="12,5"/>
                    <TextBlock x:Name="SharedFileInfo" VerticalAlignment="Center" Margin="12,0,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Семейства (отметить галкой)" Padding="4">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Content="Все" Click="OnSelectAll" Padding="10,2"/>
                        <Button Content="Снять все" Click="OnSelectNone" Margin="6,0,0,0" Padding="10,2"/>
                        <TextBlock x:Name="FamiliesCount" VerticalAlignment="Center" Margin="10,0,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Button Content="Обновить" Click="OnRefresh" Margin="10,0,0,0" Padding="10,2"/>
                    </StackPanel>
                    <ListBox x:Name="FamiliesList"
                             ItemsSource="{Binding FamilyChecks}"
                             SelectionMode="Extended"
                             PreviewMouseLeftButtonUp="OnFamiliesListMouseUp"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                          Content="{Binding Name}"
                                          VerticalAlignment="Center" Margin="2,0"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Параметры выбранных семейств" Margin="8,0,0,0" Padding="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="SelInfo" TextWrapping="Wrap" Margin="2,0,2,4"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="Отметьте одно семейство слева — покажутся все его параметры; несколько — только общие для всех."/>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="2,0,6,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox x:Name="SelFilter" Width="220" Padding="4,3" TextChanged="OnSelFilterChanged"
                                 ToolTip="Фильтрует список параметров по имени (без учёта регистра)"/>
                        <Button Content="Сбросить" Click="OnSelFilterReset" Margin="6,0,0,0" Padding="8,2"/>
                        <TextBlock x:Name="SelFilterCount" VerticalAlignment="Center" Margin="10,0,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <DataGrid x:Name="SelGrid"
                              ItemsSource="{Binding SelParams}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTextColumn Header="Тип" Binding="{Binding StorageType}" Width="1*"/>
                            <DataGridTextColumn Header="Группа" Binding="{Binding Group}" Width="1*"/>
                            <DataGridTextColumn Header="Привязка" Binding="{Binding BindingText}" Width="80" CanUserResize="False"/>
                            <DataGridTemplateColumn Header="Действия" Width="138" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Удалить" Click="OnRowRemove" Padding="8,1" Width="60"/>
                                            <Button Content="Изменить" Click="OnRowChangeBinding" Margin="4,0,0,0" Padding="8,1" Width="66"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>