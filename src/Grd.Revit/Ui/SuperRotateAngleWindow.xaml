<Window x:Class="GrdRevit.Ui.SuperRotateAngleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Супер Поворот: угол"
        Width="360"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GrdRevit;component/Ui/Themes/Modern.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock Text="Угол поворота (градусы):" FontWeight="SemiBold"/>
        <TextBox x:Name="AngleBox" Margin="0,8,0,0" Padding="8,6" FontSize="15"
                 VerticalContentAlignment="Center"
                 PreviewTextInput="OnAnglePreviewInput"/>
        <TextBlock Margin="1,8,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Text="Положительное значение — против часовой стрелки (как в штатном «Повернуть»). Этот угол запомнится и будет использоваться при следующих запусках."/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Повернуть" Style="{StaticResource PrimaryButtonStyle}" Click="OnOk"
                    Padding="16,6" FontWeight="SemiBold" IsDefault="True"/>
            <Button Content="Отмена" Click="OnCancel" Margin="8,0,0,0" Padding="16,6" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>