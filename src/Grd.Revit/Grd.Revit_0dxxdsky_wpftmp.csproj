<Project>
  <PropertyGroup>
    <AssemblyName>GrdRevit</AssemblyName>
    <IntermediateOutputPath>obj\Release\</IntermediateOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>C:\Users\user\Documents\GrdRevit\src\Grd.Revit\obj\</MSBuildProjectExtensionsPath>
    <_TargetAssemblyProjectName>Grd.Revit</_TargetAssemblyProjectName>
    <RootNamespace>GrdRevit</RootNamespace>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <!--
      net48               -> Revit 2020-2024 (uses Revit 2024 API assemblies)
      net8.0-windows      -> Revit 2025-2026 (uses Revit 2026 API assemblies)
    -->
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <UseWPF>true</UseWPF>
    <RootNamespace>GrdRevit</RootNamespace>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- Не копировать Revit API рядом с плагином -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <RestoreAdditionalProjectSources>
    </RestoreAdditionalProjectSources>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)'=='net48'">
    <DefineConstants>$(DefineConstants);REVIT2024</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)'=='net8.0-windows'">
    <DefineConstants>$(DefineConstants);REVIT2026</DefineConstants>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Grd.Core\Grd.Core.csproj" />
  </ItemGroup>
  <!-- Значки кнопки на ленте (ресурсы сборки, не копируются отдельно) -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\plugin16.png" />
    <EmbeddedResource Include="Resources\plugin32.png" />
    <EmbeddedResource Include="Resources\params16.png" />
    <EmbeddedResource Include="Resources\params32.png" />
  </ItemGroup>
  <!-- Revit 2024 API (net48, совместим с Revit 2020-2024) -->
  <ItemGroup Condition="'$(TargetFramework)'=='net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <!-- Revit 2026 API (net8.0, совместим с Revit 2025-2026) -->
