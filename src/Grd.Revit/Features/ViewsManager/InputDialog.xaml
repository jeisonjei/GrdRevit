<Window x:Class="GrdRevit.Ui.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ввод значения"
        Width="420" WindowStartupLocation="CenterOwner"
        SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GrdRevit;component/Ui/Themes/Modern.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="14">
        <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
        <TextBox x:Name="ValueBox" Padding="6,4" TextChanged="OnValueChanged"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="OK" Style="{StaticResource PrimaryButtonStyle}" Click="OnOk" x:Name="OkButton"
                    Padding="20,6" FontWeight="SemiBold" IsDefault="True" IsEnabled="False"/>
            <Button Content="Отмена" Click="OnCancel" Margin="8,0,0,0" Padding="20,6" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>