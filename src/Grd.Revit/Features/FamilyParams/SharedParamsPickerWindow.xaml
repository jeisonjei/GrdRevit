<Window x:Class="GrdRevit.Ui.SharedParamsPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить общий параметр"
        Width="500" Height="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GrdRevit;component/Ui/Themes/Modern.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBlock Text="Поиск общих параметров загруженного файла:"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,2,2"/>
            <TextBox x:Name="SearchBox" TextChanged="OnSearch" Padding="6,4"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="OkButton" Content="Добавить выбранное" IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}" Padding="12,5" IsEnabled="False" Click="OnOk"/>
            <Button Content="Отмена" IsCancel="True" Margin="8,0,0,0" Padding="12,5"/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" x:Name="CountText" Margin="2,4,2,2"
                   Foreground="{StaticResource TextSecondaryBrush}"/>

        <GroupBox Header="Общие параметры (двойной щелчок — добавить)" Padding="4">
            <ListBox x:Name="DefsList"
                     SelectionMode="Extended"
                     SelectionChanged="OnSelectionChanged"
                     MouseDoubleClick="OnDoubleClick"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Group}" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding StorageType}" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>
    </DockPanel>
</Window>