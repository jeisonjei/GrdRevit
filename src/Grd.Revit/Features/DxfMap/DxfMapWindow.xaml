<Window x:Class="GrdRevit.Ui.DxfMapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:GrdRevit.Ui"
        Title="DXF — план отопления с приборами"
        Width="1280" Height="800" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow" ResizeMode="CanResize" ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GrdRevit;component/Ui/Themes/Modern.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="8">
            <WrapPanel Orientation="Horizontal">
                <Button Content="Открыть DXF…" Padding="12,5" Style="{StaticResource PrimaryButtonStyle}"
                        Click="OnOpenDxf" />
                <Button Content="Вписать план" Padding="12,5" Margin="8,0,0,0"
                        Click="OnFitAll" />
                <ToggleButton x:Name="ValveLabelsButton" Content="Марки (n=…)" Padding="12,5" Margin="8,0,0,0"
                              ToolTip="Показать у каждого прибора марку из DXF и настройку клапана «n=…» в две строки." 
                              IsChecked="False" Checked="OnValveLabelsChanged" Unchecked="OnValveLabelsChanged" />
                <ToggleButton x:Name="DiagButton" Content="Диагностика марок" Padding="12,5" Margin="8,0,0,0"
                              ToolTip="Таблица соответствия приборов и марок: блок, размер, марка из выноски и из каталога, расстояние, настройка «n=…»."
                              Checked="OnDiagChanged" Unchecked="OnDiagChanged" />
                <ToggleButton x:Name="ApplyModeButton" Content="Применить к Revit" Padding="12,5" Margin="8,0,0,0"
                              Checked="OnApplyModeChanged" Unchecked="OnApplyModeChanged" />
                <Button x:Name="ApplySelButton" Content="Применить к выделенному" Padding="12,5" Margin="8,0,0,0"
                        Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False"
                        Click="OnApplyToSelected" />
                <Button x:Name="ApplyToViewButton" Content="Применить к текущему виду" Padding="12,5" Margin="8,0,0,0"
                        Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False"
                        ToolTip="Применяет выделенные рамкой приборы к элементам текущего вида по совпадению координат. Не применённые подсвечиваются красным кольцом."
                        Click="OnApplyToView" />
                <ToggleButton x:Name="SyncRevitButton" Content="Выделять в Revit" Padding="12,5" Margin="8,0,0,0"
                              ToolTip="При выборе приборов на плане сразу выделять соответствующие элементы текущего вида в Revit (совмещение координат, как в «Применить к текущему виду»)."
                              IsChecked="True" />
                <Button x:Name="ClearWarningsButton" Content="Очистить предупреждения" Padding="12,5" Margin="8,0,0,0"
                        Style="{StaticResource GhostButtonStyle}" IsEnabled="False"
                        Click="OnClearWarnings" />
                <Button Content="Очистить выбор" Padding="12,5" Margin="8,0,0,0" Click="OnClearSelection" />
                <Button Content="Настройки марок…" Padding="12,5" Margin="8,0,0,0"
                        Style="{StaticResource GhostButtonStyle}"
                        ToolTip="Сопоставление марок приборов из DXF с семействами/типами Revit"
                        Click="OnOpenMarksSettings" />
                <TextBlock x:Name="FileLabel" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="420" />
            </WrapPanel>
        </DockPanel>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="SummaryLabel" Foreground="{StaticResource TextSecondaryBrush}" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock x:Name="ModeHint" Text="Выберите прибор на плане — режим применения включится сам. Затем кликните элемент в Revit."
                           Foreground="#555" Margin="0,0,12,0" VerticalAlignment="Center" />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="8,0,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="420" MinWidth="300" MaxWidth="840" />
            </Grid.ColumnDefinitions>

            <ui:DxfMapControl x:Name="Map" Grid.Row="0" Grid.Column="0"
                              ClipToBounds="True" />
            <GridSplitter Grid.Row="0" Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns" Background="Transparent"
                          ToolTip="Потяните, чтобы изменить ширину панели" />
            <Border Grid.Row="0" Grid.Column="2" Background="#F6F8FB"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Margin="6,0,8,0" Padding="10,10,16,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Выбранный прибор" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock x:Name="ChosenLabel" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Foreground="{StaticResource TextPrimaryBrush}" />

                        <StackPanel x:Name="TypeCheckPanel" Margin="0,8,0,0" Visibility="Collapsed">
                            <Border x:Name="TypeCheckCard" CornerRadius="6" Padding="9,7" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock x:Name="TypeCheckTitle" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Focusable="True"
                                               ToolTip="Проверка семейства и типа элемента в Revit против марки DXF (по карте «Марки DXF → семейства»)." />
                                    <TextBlock x:Name="TypeCheckDetail" Margin="0,4,0,0" TextWrapping="Wrap"
                                               FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="MismatchPanel" Margin="0,10,0,0" Visibility="Collapsed">
                            <TextBlock Text="Несоответствия по типам DXF" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <Button x:Name="SelectFamilyMismatchButton" Content="Только семейства"
                                        Padding="8,3" FontSize="11"
                                        Style="{StaticResource GhostButtonStyle}"
                                        ToolTip="Снять выделение с совпадающих приборов и оставить только несовпавшие по семейству — для замены разом."
                                        Click="OnSelectMismatches" />
                                <Button x:Name="SelectTypeMismatchButton" Content="Только типы"
                                        Padding="8,3" FontSize="11" Margin="8,0,0,0"
                                        Style="{StaticResource GhostButtonStyle}"
                                        ToolTip="Снять выделение с совпадающих приборов и оставить только несовпавшие по типу — для замены разом."
                                        Click="OnSelectMismatches" />
                            </StackPanel>
                            <TextBlock Text="Отметьте строки — приборы выберутся на плане и в Revit; затем нажмите «Применить к выделенному» — все заменятся разом."
                                       TextWrapping="Wrap" Margin="0,5,0,4" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <ItemsControl x:Name="MismatchItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Border Padding="6,4" Margin="0,4,0,2" CornerRadius="4" Background="#EDF2F8"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                    Visibility="{Binding IsHeader, Converter={StaticResource BoolToVis}}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold"
                                                               TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding ExpectedText}" TextWrapping="Wrap" FontSize="11"
                                                               Margin="0,2,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Padding="6,4" Margin="0,2,0,0" CornerRadius="4" Background="White"
                                                    BorderBrush="#E4E9EF" BorderThickness="1"
                                                    Visibility="{Binding IsItem, Converter={StaticResource BoolToVis}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              Checked="OnMismatchToggled" Unchecked="OnMismatchToggled"
                                                              ToolTip="Выбрать в DXF и в Revit для замены" />
                                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                        <TextBlock Text="{Binding RowTitle}" FontWeight="SemiBold"
                                                                   TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" />
                                                        <TextBlock Text="{Binding RowDetail}" TextWrapping="Wrap" FontSize="11"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                                    </StackPanel>
                                                    <Border Grid.Column="2" VerticalAlignment="Center" Margin="6,0,0,6" CornerRadius="3"
                                                            Padding="5,2" Background="{Binding BadgeBrush}">
                                                        <TextBlock Text="{Binding BadgeText}" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="White" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Separator Margin="0,10,0,8" Background="{StaticResource BorderBrush}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Типы радиаторов в выборе" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <ToggleButton x:Name="TypesSortButton" Grid.Column="1" Content="По типу"
                                          Padding="6,1" FontSize="11" Margin="6,0,0,0"
                                          ToolTip="Сортировка списка: по количеству или по имени типа (А-Я)"
                                          Checked="OnTypesSortChanged" Unchecked="OnTypesSortChanged" />
                        </Grid>
                        <TextBlock x:Name="TypesEmptyLabel" Text="Выберите приборы на плане кликом или рамкой — здесь появятся типы и количество."
                                   TextWrapping="Wrap" Margin="0,6,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <ItemsControl x:Name="TypesList" Margin="0,6,0,0" Visibility="Collapsed">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="4,3" Margin="0,2,0,0" CornerRadius="4" Cursor="Hand"
                                            MouseLeftButtonUp="OnTypeRowClick"
                                            ToolTip="Нажмите, чтобы подсветить на плане все приборы этого типа. Повторный клик — снять подсветку.">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#EEF3FA" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Background" Value="#DCE8F7" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="11" Height="11" CornerRadius="2" Margin="0,0,6,0"
                                                    VerticalAlignment="Center" Background="{Binding SwatchBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Type}" TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Count, StringFormat={}{0} шт.}"
                                                       Margin="8,0,0,0" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Margin="0,10,0,8" Background="{StaticResource BorderBrush}" />

                        <TextBlock Text="Применение в Revit" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Режим «Применить к Revit»: выберите прибор на плане кликом — режим включится сам. Затем кликните элемент механического оборудования на виде Revit — марка, тип и параметры применятся сразу."
                                   TextWrapping="Wrap" Margin="0,6,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="«Применить к выделенному»: работает с текущим выделением в Revit (один или несколько элементов)."
                                   TextWrapping="Wrap" Margin="0,8,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="«Применить к текущему виду»: выберите рамкой приборы на плане и нажмите кнопку — приборы применятся к элементам вида по совпадению координат. Не применённые подсветятся красным кольцом; снять подсветку — «Очистить предупреждения»."
                                   TextWrapping="Wrap" Margin="0,8,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="«Выделять в Revit»: клик по прибору на плане сразу выделяет соответствующий элемент текущего вида в Revit (то же совмещение координат). Отключите кнопку, если синхронизация выбора не нужна."
                                   TextWrapping="Wrap" Margin="0,8,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" />

                        <Separator Margin="0,10,0,8" Background="{StaticResource BorderBrush}" />

                        <TextBlock Text="Управление планом" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Колесо — зум к курсору; правая/средняя кнопка или Пробел+левая — панорама; левая — выбор прибора."
                                   TextWrapping="Wrap" Margin="0,6,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="Рамка слева направо — «окно» (фиолетовая), справа налево — «секущая» (жёлтая)."
                                   TextWrapping="Wrap" Margin="0,8,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <DataGrid x:Name="DiagGrid" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                      Margin="0,8,0,0" MaxHeight="280" IsReadOnly="True" AutoGenerateColumns="False"
                      HeadersVisibility="Column" GridLinesVisibility="All"
                      Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                      Visibility="Collapsed"
                      FontSize="12"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Background" Value="#F0F4F8" />
                        <Setter Property="Padding" Value="6,3" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№" Binding="{Binding Seq}" Width="44" />
                    <DataGridTextColumn Header="Этаж" Binding="{Binding Floor}" Width="46" />
                    <DataGridTextColumn Header="Блок" Binding="{Binding Block}" Width="150" />
                    <DataGridTextColumn Header="Размер" Binding="{Binding Size}" Width="70" />
                    <DataGridTextColumn Header="Марка (выноска)" Binding="{Binding TruthMark}" Width="210" />
                    <DataGridTextColumn Header="Марка (каталог)" Binding="{Binding SuggestedMark}" Width="200" />
                    <DataGridTextColumn Header="n=" Binding="{Binding TruthValveSetting}" Width="46" />
                    <DataGridTextColumn Header="Используем" Binding="{Binding MarkSource}" Width="90" />
                    <DataGridTextColumn Header="Расст., мм" Binding="{Binding TruthDistance, StringFormat={}{0:N0}}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>