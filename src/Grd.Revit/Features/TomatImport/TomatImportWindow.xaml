<Window x:Class="GrdRevit.Ui.TomatImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JTOOLS: Импорт .tomat — системы и расходы"
        Width="1120" Height="680" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow" ResizeMode="CanResize" ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GrdRevit;component/Ui/Themes/Modern.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!-- Ошибки разбора файла -->
        <ItemsControl x:Name="ErrorList" DockPanel.Dock="Top" Margin="8,6,8,0"
                      Visibility="Collapsed">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Foreground="#B3261E" TextWrapping="Wrap" Margin="0,0,0,3"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="SummaryLabel" Foreground="{StaticResource TextSecondaryBrush}" />
            </StatusBarItem>
        </StatusBar>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8">
            <Button Content="Применить" Padding="18,6" FontWeight="SemiBold" IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}" Click="OnApply"
                    ToolTip="Записать системы и расходы в параметры сопоставленных пространств"/>
            <Button Content="Отмена" Padding="18,6" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Margin="8,8,8,0">
            <WrapPanel Orientation="Horizontal">
                <Button Content="Открыть .tomat…" Padding="12,5" Style="{StaticResource PrimaryButtonStyle}"
                        Click="OnOpenFile" />
                <Button Content="Автосоответствие" Padding="12,5" Margin="8,0,0,0" Click="OnAutoMatch"
                        ToolTip="Сопоставить помещения с пространствами по номеру (точное совпадение), затем по имени (без учёта регистра). Каждое пространство используется один раз."/>
                <TextBlock x:Name="FileLabel" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="360" />
            </WrapPanel>
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="Применение: у сопоставленного помещения в параметры пространства записываются приточная/вытяжная система (текст) и расходы воздуха (м³/ч). Несопоставленные строки можно сопоставить вручную или оставить пустыми — они в применении не участвуют."/>
        </StackPanel>

        <!-- Параметры пространства Revit -->
        <GroupBox DockPanel.Dock="Top" Header="Параметры пространства Revit (записываются при применении)"
                  Margin="8,8,8,0" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Приточная система (текст)" VerticalAlignment="Center"/>
                    <ComboBox x:Name="SupplySystemParamBox" Margin="0,3,0,0" IsEditable="True" IsTextSearchEnabled="False" IsSynchronizedWithCurrentItem="False"
                              Text="{Binding SupplySystemParam, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=Window}}"
                              ToolTip="Начните вводить название — список отфильтруется по мере ввода; выберите совпадение кликом или стрелками."/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Вытяжная система (текст)" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ExhaustSystemParamBox" Margin="0,3,0,0" IsEditable="True" IsTextSearchEnabled="False" IsSynchronizedWithCurrentItem="False"
                              Text="{Binding ExhaustSystemParam, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=Window}}"
                              ToolTip="Начните вводить название — список отфильтруется по мере ввода; выберите совпадение кликом или стрелками."/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,8,0">
                    <TextBlock Text="Расход приточного воздуха (число)" VerticalAlignment="Center"/>
                    <ComboBox x:Name="SupplyAirflowParamBox" Margin="0,3,0,0" IsEditable="True" IsTextSearchEnabled="False" IsSynchronizedWithCurrentItem="False"
                              Text="{Binding SupplyAirflowParam, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=Window}}"
                              ToolTip="Начните вводить название — список отфильтруется по мере ввода; выберите совпадение кликом или стрелками."/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,8,0,0">
                    <TextBlock Text="Расход вытяжного воздуха (число)" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ExhaustAirflowParamBox" Margin="0,3,0,0" IsEditable="True" IsTextSearchEnabled="False" IsSynchronizedWithCurrentItem="False"
                              Text="{Binding ExhaustAirflowParam, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=Window}}"
                              ToolTip="Начните вводить название — список отфильтруется по мере ввода; выберите совпадение кликом или стрелками."/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Таблица соответствия -->
        <DockPanel Margin="8">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <TextBlock Text="Сопоставление: помещения .tomat → пространства Revit  (в ячейке «Пространство Revit» начните вводить номер или имя — список отфильтруется по мере ввода)"
                           FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
            <DataGrid x:Name="RowsGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="All"
                      IsReadOnly="False">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Помещение .tomat" Width="2.4*" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="4,0">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Medium"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding InfoLabel}" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Приток" Binding="{Binding SupplyLabel}" Width="0.9*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Вытяжка" Binding="{Binding ExhaustLabel}" Width="0.9*" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="Статус" Width="1.1*" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusLabel}" VerticalAlignment="Center" Margin="4,0"
                                           FontWeight="Medium">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMatched}" Value="False">
                                                    <Setter Property="Foreground" Value="#B3261E"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Пространство Revit" Width="2.6*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SelectedLabel, Mode=OneWay}"
                                           VerticalAlignment="Center" Margin="4,0"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding Spaces}"
                                          SelectedItem="{Binding SelectedSpace, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          DisplayMemberPath="" IsEditable="True" IsSynchronizedWithCurrentItem="False"
                                          Loaded="OnSpaceComboLoaded"
                                          BorderThickness="0" Padding="2,0" VerticalContentAlignment="Center"
                                          ToolTip="Начните вводить номер или имя — список отфильтруется по мере ввода."/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </DockPanel>
</Window>