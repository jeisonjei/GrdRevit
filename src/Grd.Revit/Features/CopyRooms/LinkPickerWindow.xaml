<Window x:Class="GrdRevit.Ui.LinkPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Скопировать комнаты: выбор связи"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        MinWidth="380"
        MaxHeight="560">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GrdRevit;component/Ui/Themes/Modern.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock Text="Выберите связь АР, из которой скопировать помещения:"
                   FontWeight="SemiBold" TextWrapping="Wrap"/>
        <ListBox x:Name="LinksList" Margin="0,10,0,0" Height="180"
                 DisplayMemberPath="DisplayText"
                 SelectionMode="Single"
                 MouseDoubleClick="OnListDoubleClick"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Выбрать" Style="{StaticResource PrimaryButtonStyle}" Click="OnOk"
                    Padding="16,6" FontWeight="SemiBold" IsDefault="True"/>
            <Button Content="Отмена" Click="OnCancel" Margin="8,0,0,0" Padding="16,6" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>