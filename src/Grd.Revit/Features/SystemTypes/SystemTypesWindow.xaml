<Window x:Class="GrdRevit.Ui.SystemTypesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JTOOLS: Типы систем"
        Width="1000" Height="600"
        MinWidth="840" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Closing="OnClosing">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GrdRevit;component/Ui/Themes/Modern.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="10">
        <Border DockPanel.Dock="Bottom" Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="4" Padding="10,6" Margin="0,8,0,0">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                       Text="Правки не применяются мгновенно: изменённые ячейки подсвечиваются жёлтым, в модель они попадают по «Сохранить изменения». Порядок строк соответствует порядку в легенде — перетаскивайте их мышкой. Для каждого типа создаётся стиль линий «Grd_Трубы_…»/«Grd_Воздуховоды_…»: цвет и тип линий берутся из типа, толщина — из «Толщина линий легенды» (4 по умолчанию). Стиль сохраняется при переносе легенды на листы. Легенду можно создавать в графическом виде или в виде «Легенда»."/>
        </Border>

        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Набор типов:" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <ComboBox x:Name="KindCombo" Width="170" Margin="6,0,0,0"
                              SelectionChanged="OnKindChanged"
                              ToolTip="«Трубы» — типы трубных систем (PipingSystemType), «Воздуховоды» — типы систем воздуховодов (MechanicalSystemType)">
                        <ComboBoxItem Content="Трубы"/>
                        <ComboBoxItem Content="Воздуховоды"/>
                    </ComboBox>
                    <Button Content="Экспорт в Excel" Click="OnExportExcel" Margin="18,0,0,0"
                            Style="{StaticResource GhostButtonStyle}" Padding="12,5"
                            ToolTip="Выгрузить текущий набор (трубы или воздуховоды) в книгу Excel: имя, сокращение, цвет, толщина линий, тип линий"/>
                    <Button Content="Копировать" Click="OnDuplicateSelected" Margin="8,0,0,0"
                            Style="{StaticResource GhostButtonStyle}" Padding="12,5"
                            ToolTip="Дублировать выбранный тип системы: имя «Имя (копия)». Копия создаётся сразу"/>
                    <TextBlock Text="Толщина линий легенды:" VerticalAlignment="Center" Margin="16,0,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <ComboBox x:Name="LegendWeightCombo" Width="58" Margin="6,0,0,0"
                              ItemsSource="{Binding Weights, RelativeSource={RelativeSource AncestorType=Window}}"
                              ToolTip="Толщина линий (1–16) для всех стилей линий легенды сразу. По умолчанию 4"/>
                    <Button Content="Создать легенду" Click="OnDrawLegend" Margin="12,0,0,0"
                            Style="{StaticResource GhostButtonStyle}" Padding="12,5"
                            ToolTip="Рисует вертикальный стек линий 1000 мм в активном виде (или виде «Легенда») в порядке строк таблицы. Линии используют персональный стиль типа; толщина — из «Толщина линий легенды». Перетаскивайте строки, чтобы изменить порядок"/>
                    <Button Content="Сохранить изменения" Click="OnSave" Margin="8,0,0,0"
                            Style="{StaticResource PrimaryButtonStyle}" Padding="14,5" FontWeight="SemiBold"
                            ToolTip="Применить к типам систем изменённые ячейки текущего набора"/>
                    <TextBlock x:Name="CountText" VerticalAlignment="Center" Margin="18,0,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" Margin="1,6,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>

            <DataGrid x:Name="Grid" Margin="0,0,0,4"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      EnableRowVirtualization="True"
                      AllowDrop="True"
                      DragOver="OnGridDragOver"
                      Drop="OnGridDrop"
                      PreviewMouseLeftButtonDown="OnGridPreviewMouseLeftButtonDown"
                      PreviewMouseMove="OnGridPreviewMouseMove"
                      ItemsSource="{Binding Rows, RelativeSource={RelativeSource AncestorType=Window}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Имя" Width="2*" MinWidth="180" SortMemberPath="Name"
                                        Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Background" Value="{Binding NameDirtyBrush}"/>
                                <Setter Property="Margin" Value="2,2"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="Background" Value="{Binding NameDirtyBrush}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="4,0"/>
                                <Setter Property="Margin" Value="2,2"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Сокращение" Width="*" MinWidth="90" SortMemberPath="Abbreviation"
                                        Binding="{Binding Abbreviation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Background" Value="{Binding AbbreviationDirtyBrush}"/>
                                <Setter Property="Margin" Value="2,2"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="Background" Value="{Binding AbbreviationDirtyBrush}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="4,0"/>
                                <Setter Property="Margin" Value="2,2"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="Цвет" Width="*" MinWidth="130" SortMemberPath="ColorSortKey">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Click="OnPickColor" HorizontalContentAlignment="Stretch"
                                        Background="{Binding ColorDirtyBrush}" BorderThickness="0"
                                        Padding="4,2" Margin="2,2"
                                        ToolTip="Цвет линий системы. Открывает редактор цвета с RGB и HEX">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="18" Height="14" BorderBrush="#8B93A5"
                                                BorderThickness="1" Background="{Binding ColorBrush}"/>
                                        <TextBlock Text="{Binding ColorHex}" Margin="6,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Толщина линий" Width="130" SortMemberPath="LineWeight">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding Weights, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding LineWeight, Mode=TwoWay}"
                                          Background="{Binding LineWeightDirtyBrush}"
                                          Margin="2,2" ToolTip="Толщина линий системы (1–16)"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Тип линий" Width="2*" MinWidth="170" SortMemberPath="PatternSortKey">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding Patterns, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedValuePath="Key" DisplayMemberPath="Name"
                                          SelectedValue="{Binding PatternKey, Mode=TwoWay}"
                                          Background="{Binding PatternDirtyBrush}"
                                          Margin="2,2" ToolTip="Паттерн (тип) линий системы из документа"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </DockPanel>
</Window>